# --- Veritabanı ---
# cPanel sunucunuzdaki MySQL veritabanına UZAKTAN bağlanıyorsunuz — host artık
# "localhost" değil, cPanel sunucunuzun genel (public) IP'si veya hostname'i.
# Bunun için cPanel > Remote MySQL sayfasından kendi bilgisayarınızın IP'sine
# erişim izni vermeniz gerekir (bkz. README.md > "Yerel kurulum").
DATABASE_URL="mysql://cpaneluser_dbkullanici:sifre@SUNUCU_IP_ADRESI:3306/cpaneluser_lucidmove"

# --- NextAuth ---
# Terminalde `openssl rand -base64 32` ile üretebilirsiniz.
NEXTAUTH_SECRET="degistirin-bu-cok-gizli-bir-anahtar-olmali"
# Yerel geliştirmede XAMPP ile lucidmove.local kullanıyorsanız:
NEXTAUTH_URL="http://lucidmove.local"
# Canlıya aldığınızda şuna değiştirin: NEXTAUTH_URL="https://lucidmove.net"

# --- Iyzico (ödeme sağlayıcı) ---
# Sandbox (test) anahtarlarını https://sandbox-merchant.iyzipay.com adresinden alın.
IYZICO_API_KEY="sandbox-xxxxxxxxxxxxxxxx"
IYZICO_SECRET_KEY="sandbox-xxxxxxxxxxxxxxxx"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# --- Fiyatlandırma (TL) ---
# Bu değerler artık ödeme tutarını BELİRLEMEZ — sadece `prisma db seed`
# ilk çalıştığında PricingPlan tablosuna yazılacak başlangıç fiyatlarıdır.
# Gerçek fiyat her zaman veritabanından (admin panel > Fiyatlandırma)
# okunur; kurulumdan sonra fiyatı değiştirmek için admin paneli kullanın.
AYLIK_UCRET="299.90"
YILLIK_UCRET="2399.90"

# --- İletişim formu (opsiyonel e-posta bildirimi) ---
CONTACT_EMAIL_TO="ornek@lucidmove.net"

# --- Veritabanı yedekleme (admin > Ayarlar > Yedekleme) ---
# Sunucunuzda mysqldump kuruluysa ve PATH'teyse boş bırakabilirsiniz. Windows'ta
# XAMPP kullanıyorsanız genelde C:\xampp\mysql\bin\mysqldump.exe'dir.
MYSQLDUMP_PATH=""
