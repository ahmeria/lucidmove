// LucidMove — Veritabanı Şeması
// MySQL/MariaDB kullanılıyor (cPanel'in varsayılan veritabanı türü).
// Kurulum için README.md dosyasına bakın.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  AYLIK
  YILLIK
}

enum SubscriptionStatus {
  AKTIF
  IPTAL_EDILDI
  SUresi_DOLDU
  BEKLEMEDE
}

enum PaymentStatus {
  BASARILI
  BASARISIZ
  BEKLEMEDE
}

enum Role {
  UYE
  ADMIN
}

// Filigranlama özelliği kaldırıldı (bkz. git geçmişi, lib/filigran.ts
// silindi) — Lesson.filigranDurumu artık her zaman HAZIR yazılıyor.
enum FiligranDurumu {
  BEKLIYOR
  ISLENIYOR
  HAZIR
  HATA
}

model User {
  id                 String    @id @default(cuid())
  ad                 String
  email              String    @unique
  telefon            String?   @db.VarChar(32)
  passwordHash       String
  role               Role      @default(UYE)
  // Admin'ler içinde yalnızca /admin/ayarlar/** bölümüne erişebilen tekil (ya da az
  // sayıda) hesap işareti — Kullanıcılar/Roller/Cache/Yedekleme/Sistem Logları bu
  // bayrağı gerektirir (bkz. lib/admin-auth.ts > getAdminSession).
  sistemYoneticisiMi Boolean   @default(false)
  // Özel panel rolü (bkz. AdminRole) — yalnızca sayfa bazında kısıtlı erişimi
  // olan admin hesapları için kullanılır. null: sistemYoneticisiMi hariç eski/
  // varsayılan admin davranışı (Ayarlar dışındaki tüm sayfalara erişim, bkz.
  // lib/adminYetki.ts). sistemYoneticisiMi=true olan hesaplarda bu alan
  // anlamsızdır — her zaman tam erişim vardır.
  adminRoleId        String?
  adminRole          AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  profilFotoUrl      String?   @db.VarChar(512)
  emailVerified      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  progress      LessonProgress[]
  systemLogs    SystemLog[]
  backups       Backup[]
}

// Admin panelinde özel/kısıtlı erişimli roller — admin panelden oluşturulur
// (bkz. app/admin/ayarlar/roller). Ayarlar bölümü bilerek bu mekanizmanın
// dışında tutuldu (kullanıcı yönetimi, yedekleme, güncelleme gibi hassas
// işlemler yalnızca sistemYoneticisiMi ile açılabilir — bir özel role yanlışlıkla
// bu yetkiler verilemez, bkz. lib/adminYetki.ts).
model AdminRole {
  id        String   @id @default(cuid())
  ad        String   @unique @db.VarChar(100)
  // İzin verilen admin sayfalarının href listesi (ör. ["/admin/kategoriler",
  // "/admin/kurslar"]) — admin-nav-data.tsx'teki hreflerle eşleşir.
  sayfalar  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kullanicilar User[]
}

// Admin panel denetim günlüğü — giriş denemeleri + admin işlemleri (bkz. lib/systemLog.ts).
model SystemLog {
  id       String @id @default(cuid())
  seviye   String // "INFO" | "ERROR"
  kategori String // "auth" | "kategori" | "kurs" | "ders" | "kullanici" | "uyelik" | "cache" | "yedekleme" | "guncelleme" | "yorum" | "rol"
  aksiyon  String // "login" | "login_basarisiz" | "olustur" | "guncelle" | "sil" | "temizle" | "iptal" | "hata"

  kaynakEtiketi String? // insan-okunabilir özet (örn. kurs başlığı) — kayıt silinse de okunur kalır
  mesaj         String? @db.Text

  userId        String?
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  kullaniciEtiketi String? // olay anındaki ad/e-posta anlık görüntüsü (kullanıcı silinse de kalır)

  createdAt DateTime @default(now())

  @@index([kategori, createdAt])
  @@index([seviye, createdAt])
}

// Manuel tetiklenen veritabanı yedekleri (bkz. lib/backup.ts). Dosyalar public/ dışında,
// storage/backups/ altında tutulur — bu tablo yalnızca meta veriyi taşır.
model Backup {
  id           String   @id @default(cuid())
  dosyaAdi     String   @db.VarChar(255)
  dosyaBoyutu  Int // byte
  tur          String // "manuel" | "otomatik" (şu an yalnızca "manuel" üretiliyor)
  durum        String // "basarili" | "basarisiz"
  hataMesaji   String?  @db.Text
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model Subscription {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  plan               PlanType
  status             SubscriptionStatus @default(BEKLEMEDE)
  iyzicoSubscriptionRef String?         @unique
  startedAt          DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments Payment[]

  @@index([userId])
}

model Payment {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  iyzicoPaymentId String?      @unique
  tutar          Decimal       @db.Decimal(10, 2)
  paraBirimi     String        @default("TRY")
  durum          PaymentStatus @default(BEKLEMEDE)
  createdAt      DateTime      @default(now())

  @@index([userId])
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  baslik      String
  aciklama    String   @db.Text
  seviye      String   // Başlangıç / Orta / İleri — GRUPLAMA anahtarı, dilden bağımsız SABİT kalır
  // İngilizce/Azerbaycan çeviri varyantları — boşsa frontend Türkçe'ye düşer
  // (bkz. lib/i18nIcerik.ts > cevrilenAlan). seviyeEn/seviyeAz yalnızca GÖSTERİM
  // etiketidir, filtre/gruplama mantığı hep `seviye` (Türkçe) üzerinden çalışır.
  baslikEn    String?
  baslikAz    String?
  aciklamaEn  String?  @db.Text
  aciklamaAz  String?  @db.Text
  seviyeEn    String?
  seviyeAz    String?
  kapakUrl    String?  @db.VarChar(512)
  tanitimVideoUrl String? @db.VarChar(512) // YouTube linki ya da /uploads/videos/... yerel dosya yolu
  sira        Int      @default(0)
  createdAt   DateTime @default(now())

  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  slug        String
  baslik      String
  aciklama    String?  @db.Text // video özeti / içerik bilgisi
  // İngilizce/Azerbaycan çeviri varyantları — bkz. Course'daki aynı desen.
  baslikEn    String?
  baslikAz    String?
  aciklamaEn  String?  @db.Text
  aciklamaAz  String?  @db.Text
  kapakUrl    String?  @db.VarChar(512) // ders listesinde küçük önizleme — yoksa boş görsel yer tutucu gösterilir
  sureDakika  Int
  kaynakVideoUrl String @db.VarChar(512) // admin'in yüklediği ham dosya — /uploads/videos/...
  // Üyeye servis edilen video. Filigranlama kaldırıldı (bkz. git geçmişi) —
  // artık her zaman kaynakVideoUrl ile aynı, ekstra işleme adımı yok.
  videoUrl    String?  @db.VarChar(512)
  // Filigranlama sürecinden kalma alan — artık her zaman HAZIR yazılıyor,
  // fonksiyonel bir anlamı yok. Şema kararlılığı için (gereksiz migration'dan
  // kaçınmak amacıyla) kaldırılmadı.
  filigranDurumu FiligranDurumu @default(BEKLIYOR)
  ucretsizMi  Boolean  @default(false) // tanıtım için ücretsiz izlenebilir mi
  // Ruh hali etiketi (ör. "enerji", "guc", "besle", "rahatla") — bkz.
  // lib/moods.ts. Opsiyonel: eski dersler boş kalır, admin dilerse elle
  // etiketler. Kurslar sayfasındaki "Moodlar" bölümü buna göre filtreler.
  mood        String?  @db.VarChar(50)
  sira        Int      @default(0)
  createdAt   DateTime @default(now())

  progress LessonProgress[]

  @@unique([courseId, slug])
}

model LessonProgress {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   String
  tamamlandi Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([userId, lessonId])
}

// Tekil satır (id: "ana") — site geneli metinler, iletişim bilgisi, SEO.
// Admin panelinden "Genel Ayarlar" sayfasında düzenlenir.
model SiteSettings {
  id String @id @default("ana")

  // Kayıtlı/gösterilen "varsayılan site dili" — Admin > Genel Ayarlar'dan
  // seçilir ("tr" | "en" | "az"). NOT: URL'de hangi dilin öneksiz (gerçek
  // varsayılan) olacağı next-intl'in routing yapılandırmasında (bkz.
  // i18n/routing.ts) SABİT kod seviyesinde tutuluyor — bu, Next.js'in
  // locale yönlendirmesini Edge ortamındaki middleware'de yaptığı ve o
  // ortamın bu projenin MySQL/Prisma bağlantısına performans/güvenilirlik
  // riski olmadan erişemediği için bilinçli bir sınır. Bu alan şu an için
  // kayıtlı bir tercih/gösterge; gerçek routing varsayılanını değiştirmek
  // kod tarafında tek satırlık bir güncelleme gerektiriyor.
  varsayilanDil   String @default("tr") @db.VarChar(2)

  siteBasligi     String @db.VarChar(255)
  siteAciklamasi  String @db.Text
  siteBasligiEn    String? @db.VarChar(255)
  siteBasligiAz    String? @db.VarChar(255)
  siteAciklamasiEn String? @db.Text
  siteAciklamasiAz String? @db.Text

  heroEyebrow      String @db.VarChar(255)
  heroBaslik       String @db.Text
  heroAltBaslik    String @db.Text
  heroEyebrowEn    String? @db.VarChar(255)
  heroEyebrowAz    String? @db.VarChar(255)
  heroBaslikEn     String? @db.Text
  heroBaslikAz     String? @db.Text
  heroAltBaslikEn  String? @db.Text
  heroAltBaslikAz  String? @db.Text
  // Ana sayfa üst bölümün arkaplan görseli — admin panelden yüklenir (bkz.
  // /admin/ayarlar/sayfa-tasarimi). Var olan kurulumlarda geriye dönük
  // uyumluluk için önceki sabit kodlanmış görsel varsayılan değer olarak atanır.
  heroGorselUrl    String @default("https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=1800&auto=format&fit=crop") @db.VarChar(512)
  // Arkaplan videosu (opsiyonel) — doluysa hero bölümünde heroGorselUrl yerine
  // bu video oynatılır (görsel yalnızca poster/yüklenene kadar geçici görüntü
  // olarak kullanılır); boşsa heroGorselUrl statik arkaplan olarak gösterilir.
  heroVideoUrl     String? @db.VarChar(512)
  heroCtaBirincil  String @db.VarChar(100)
  heroCtaIkincil   String @db.VarChar(100)
  heroCtaBirincilEn String? @db.VarChar(100)
  heroCtaBirincilAz String? @db.VarChar(100)
  heroCtaIkincilEn  String? @db.VarChar(100)
  heroCtaIkincilAz  String? @db.VarChar(100)

  uyelikEyebrow    String @db.VarChar(255)
  uyelikBaslik     String @db.Text
  uyelikAltBaslik  String @db.Text
  uyelikEyebrowEn    String? @db.VarChar(255)
  uyelikEyebrowAz    String? @db.VarChar(255)
  uyelikBaslikEn     String? @db.Text
  uyelikBaslikAz     String? @db.Text
  uyelikAltBaslikEn  String? @db.Text
  uyelikAltBaslikAz  String? @db.Text

  iletisimEmail    String @db.VarChar(255)
  calismaSaatleri  String @db.VarChar(255)
  calismaSaatleriEn String? @db.VarChar(255)
  calismaSaatleriAz String? @db.VarChar(255)
  instagramUrl     String @db.VarChar(512)
  footerTagline    String @db.Text
  footerTaglineEn  String? @db.Text
  footerTaglineAz  String? @db.Text

  // Para birimi: yalnızca EKRANDA GÖSTERİM biçimini etkiler — Iyzico ödeme tutarı her
  // zaman PricingPlan.fiyat'tan (TL) hesaplanır, bu alan tutarı DEĞİŞTİRMEZ.
  paraBirimi         String @default("TRY") @db.VarChar(3) // "TRY" | "USD" | "EUR"
  // "ONCE_SEMBOL" -> "₺299,90" | "SONRA_SEMBOL" -> "299,90 ₺" | "KOD" -> "TRY 299,90"
  paraBirimiGosterimi String @default("ONCE_SEMBOL") @db.VarChar(20)

  // Google Analytics 4 Measurement ID (ör. "G-XXXXXXXXXX") — doluysa app/(site)/layout.tsx
  // gtag.js'i yalnızca herkese açık sayfalarda enjekte eder (admin panelinde hiç yüklenmez).
  // Bu, veriyi TOPLAYAN taraf. Aşağıdaki ikisi ise TOPLANAN veriyi panele geri OKUYAN taraf
  // (GA4 Data API) — birbirinden bağımsız, biri olmadan diğeri çalışmaz (bkz. lib/analitikVerisi.ts).
  gaMeasurementId String? @db.VarChar(20)
  // GA4 mülk kimliği (Property ID) — Data API isteklerinde "properties/{id}" olarak kullanılır.
  gaPropertyId String? @db.VarChar(30)
  // Servis hesabı JSON anahtarı — AES-256-GCM ile şifreli saklanır (bkz. lib/crypto.ts),
  // düz metin olarak asla DB'ye yazılmaz.
  gaServiceAccount String? @db.Text

  updatedAt DateTime @updatedAt
}

// Tekil satır (id: "ana") — eğitmen profili. Admin panelinden düzenlenir.
model InstructorProfile {
  id String @id @default("ana")

  ad                  String @db.VarChar(255) // özel isim — dilden bağımsız, çevrilmiyor
  bio                 String @db.Text // paragraflar boş satırla ayrılır
  sertifikalar        String @db.Text // satır satır liste
  yaklasim            String @db.Text // satır satır liste
  portreUrl           String @db.VarChar(512)
  hakkimdaTeaserOzet  String @db.Text // ana sayfadaki kısa tanıtım metni
  bioEn                String? @db.Text
  bioAz                String? @db.Text
  sertifikalarEn       String? @db.Text
  sertifikalarAz       String? @db.Text
  yaklasimEn           String? @db.Text
  yaklasimAz           String? @db.Text
  hakkimdaTeaserOzetEn String? @db.Text
  hakkimdaTeaserOzetAz String? @db.Text

  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id         String   @id @default(cuid())
  plan       PlanType @unique
  baslik     String   @db.VarChar(100)
  fiyat      Decimal  @db.Decimal(10, 2)
  periyot    String   @db.VarChar(50)
  aciklama   String   @db.Text
  ozellikler String   @db.Text // satır satır liste
  rozet      String?  @db.VarChar(100)
  baslikEn     String? @db.VarChar(100)
  baslikAz     String? @db.VarChar(100)
  periyotEn    String? @db.VarChar(50)
  periyotAz    String? @db.VarChar(50)
  aciklamaEn   String? @db.Text
  aciklamaAz   String? @db.Text
  ozelliklerEn String? @db.Text
  ozelliklerAz String? @db.Text
  rozetEn      String? @db.VarChar(100)
  rozetAz      String? @db.VarChar(100)
  vurgulu    Boolean  @default(false)
  sira       Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Anasayfa "Pratikleriyle değişenler" bölümü — admin panelden yönetilir
// (bkz. app/admin/yorumlar). Birden fazla kayıt olduğunda anasayfada yatayda
// kaydırılabilir bir şeride dönüşür (bkz. app/(site)/page.tsx > YORUMLAR).
model Testimonial {
  id        String   @id @default(cuid())
  isim      String   @db.VarChar(100)
  rol       String   @db.VarChar(100)
  yorum     String   @db.Text
  sira      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ders "mood" (ruh hali) etiketleri — admin panelden yönetilir (bkz.
// app/admin/moods). Lesson.mood bu tabloya FK değil, "slug" değerine göre
// SERBEST eşleşir (Course.seviye ile aynı desen) — bir mood silinirse
// bağlı derslerdeki etiket sessizce "yetim" kalır, hata vermez. "slug"
// yalnızca oluşturulurken addan türetilir ve sonrasında SABİT kalır — aksi
// halde ad değişince mevcut ders eşleşmeleri kopardı.
model Mood {
  id        String   @id @default(cuid())
  ad        String   @db.VarChar(100)
  adEn      String?  @db.VarChar(100)
  adAz      String?  @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  gorselUrl String?  @db.VarChar(512)
  sira      Int      @default(0)
  createdAt DateTime @default(now())
}

// Anasayfa "Stüdyodan kareler" galerisi — admin panelden yönetilir (bkz.
// app/admin/ayarlar/sayfa-tasarimi). Tablo boşsa lib/settings.ts >
// getGaleriGorselleri() önceki sabit kodlanmış görselleri varsayılan olarak ekler.
model GaleriGorseli {
  id        String   @id @default(cuid())
  url       String   @db.VarChar(512)
  alt       String?  @db.VarChar(255)
  sira      Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(cuid())
  ad         String   @db.VarChar(255)
  email      String   @db.VarChar(255)
  mesaj      String   @db.Text
  okunduMu   Boolean  @default(false)
  createdAt  DateTime @default(now())
}
